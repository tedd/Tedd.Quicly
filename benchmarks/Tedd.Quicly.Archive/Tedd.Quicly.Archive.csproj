<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Archived (superseded) implementations kept for benchmark comparison. Never referenced by shipping code.</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1822;IDE0051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Archived versions reuse the public value types (tokens, enums) of the code that replaced them. -->
    <ProjectReference Include="..\..\src\Tedd.Quicly.Core\Tedd.Quicly.Core.csproj" />
  </ItemGroup>
</Project>
